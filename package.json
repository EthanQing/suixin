{
  "name": "suixin-todo",
  "version": "1.1.0",
  "description": "完全本地的极简多项目桌面待办小窗",
  "main": "src/main.js",
  "author": "Suixin Todo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/store.test.js",
    "test:e2e": "playwright test",
    "test:packaged": "node tests/packaged-smoke.js",
    "test:nsis": "node tests/packaged-smoke.js --nsis",
    "check": "node --check src/main.js && node --check src/store.js && node --check src/preload.js && node --check src/renderer.js",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:dir": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.suixin.todo",
    "productName": "随心待办",
    "artifactName": "SuixinTodo-${version}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "assets/icon.ico", "assets/tray.ico", "package.json"],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "SuixinTodo-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "SuixinTodo-Portable-${version}-${arch}.${ext}" }
  }
}
